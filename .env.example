# Erforderlich für das Löschen von Ranglisten-Einträgen. Mindestens 20 zufällige Zeichen verwenden.
# Ohne diese Variable bleibt die Admin-Löschfunktion bewusst deaktiviert.
ADMIN_DELETE_PASSWORD=replace_with_a_long_random_secret

# Uploads und direkte Audio-Downloads: standardmäßig maximal 2 GiB pro Datei.
# Für sehr große Aufnahmen bei ausreichend Speicher z. B. 21474836480 (20 GiB).
MAX_MEDIA_BYTES=2147483648

# Ressourcen-Drosselung für Proxmox LXC / Server mit begrenztem RAM
# CPU-Threads für Whisper (Standard: 2). Schont CPU und halbiert den Spitzen-RAM.
WHISPER_THREADS=2

# KI-Modell: 'small' (Standard, hohe Genauigkeit) oder 'base' (3x schneller, benötigt nur ~300MB RAM)
WHISPER_MODEL=small

# Persistente Zwischenspeicherung für lange Analysen (Standard: <Projekt>/.analysis-jobs)
# ANALYSIS_JOBS_DIR=/var/lib/aehm-zaehler/analysis-jobs
