ADMIN_DELETE_PASSWORD=your_secure_password

# Ressourcen-Drosselung für Proxmox LXC / Server mit begrenztem RAM
# CPU-Threads für Whisper (Standard: 2). Schont CPU und halbiert den Spitzen-RAM.
WHISPER_THREADS=2

# KI-Modell: 'small' (Standard, hohe Genauigkeit) oder 'base' (3x schneller, benötigt nur ~300MB RAM)
WHISPER_MODEL=small